# Frontend environment variables (template).
# Copy to .env for local overrides, or set in the Vercel dashboard for production.

# Backend API base URL. Leave unset locally (Vite proxies /api -> localhost:8080).
# In production set this to your deployed backend, e.g.:
# VITE_API_BASE_URL=https://your-app.onrender.com/api/v1
VITE_API_BASE_URL=
